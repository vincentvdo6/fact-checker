{
  "manifest_version": 3,
  "name": "Fact checker for YouTube",
  "version": "0.1.0",
  "description": "Check recent YouTube captions against evidence on your computer.",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Check what I just heard on YouTube"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
